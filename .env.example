# PostgreSQL Configuration
NAME=phonebook
POSTGRES_VERSION=18
POSTGRES_USER=admin
POSTGRES_PASSWORD=replace_with_a_strong_unique_password
POSTGRES_DB=phonebook_db
POSTGRES_PORT=5432
POSTGRES_INITDB_ARGS=--encoding=UTF8
POSTGRES_INIT_SCRIPTS_DIR=./sql/init-scripts

# PostgreSQL Performance Tuning
PG_MAX_CONNECTIONS=50
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=4GB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=512MB
PG_RANDOM_PAGE_COST=1.1
PG_TEMP_FILE_LIMIT=10GB
PG_LOG_MIN_DURATION=200ms
PG_IDLE_IN_TRANSACTION_TIMEOUT=10s
PG_LOCK_TIMEOUT=1s
PG_STATEMENT_TIMEOUT=60s
PG_LOG_STATEMENT=none

# PostgreSQL Resource Limits
PG_CPU_LIMIT=2
PG_MEMORY_LIMIT=6G
PG_CPU_RESERVED=1
PG_MEMORY_RESERVED=4G

# pgAdmin Configuration
PGADMIN_VERSION=replace_with_a_pinned_version
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=replace_with_a_strong_unique_password
PGADMIN_PORT=5050
PGADMIN_SERVER_MODE=False

# pgAdmin Resource Limits
PGADMIN_CPU_LIMIT=0.5
PGADMIN_MEMORY_LIMIT=1G
PGADMIN_CPU_RESERVED=0.25
PGADMIN_MEMORY_RESERVED=512M

# PostgreSQL Analytics (pg_stat_statements)
PG_STAT_STATEMENTS_MAX=10000
PG_STAT_STATEMENTS_TRACK=all

# Flyway Database Migrations
FLYWAY_VERSION=replace_with_a_pinned_version
FLYWAY_MIGRATIONS_DIR=./flyway/sql
FLYWAY_ENVIRONMENT=dev
FLYWAY_OUT_OF_ORDER=false
FLYWAY_VALIDATE_ON_MIGRATE=true

# Flyway Resource Limits
FLYWAY_CPU_LIMIT=0.25
FLYWAY_MEMORY_LIMIT=512M
FLYWAY_CPU_RESERVED=0.1
FLYWAY_MEMORY_RESERVED=256M

# Do not commit the real .env file. Keep it local or inject secrets
# through your deployment platform's secret manager.
