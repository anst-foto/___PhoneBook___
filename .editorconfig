root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# XML and project/configuration files
[*.xml]
indent_size = 2

[*.{csproj,fsproj,vbproj,proj,slnx}]
indent_size = 2

[*.{props,targets,config,nuspec}]
indent_size = 2

# JSON / YAML
[*.{json,jsonc,yml,yaml}]
indent_size = 2

# JavaScript / React
[*.{js,jsx,mjs,cjs}]
indent_size = 2
quote_type = single

# TypeScript / React
[*.{ts,tsx,mts,cts}]
indent_size = 2
quote_type = single

# HTML / CSS and related frontend styles
[*.{html,htm,css,scss,sass,less}]
indent_size = 2

# Shell scripts use LF as configured in .gitattributes
[*.{bash,fish,ksh,sh,zsh}]
end_of_line = lf

# Windows command scripts use CRLF as configured in .gitattributes
[*.{bat,cmd}]
end_of_line = crlf

# Markdown: retain intentional trailing spaces, e.g. for line breaks
[*.{md,mdx}]
trim_trailing_whitespace = false

# C# files
[*.cs]
indent_size = 4
tab_width = 4
